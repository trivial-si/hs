# Maintainer: Ivan Filković <ifilkovic@users.noreply.github.com>
pkgname=hs-time
pkgver=0.1.2
pkgrel=1
pkgdesc="Local time tracking, tasks, and focus sessions for your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/trivial-si/hs"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('cargo')
optdepends=(
  'libpulse: completion sound via paplay'
  'pipewire-audio: completion sound via pw-play'
  'alsa-utils: completion sound via aplay'
)
provides=('hs-time')
conflicts=('hs-time-bin')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/trivial-si/hs/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('1857954fda7e68d88b12b2fbb30c31aa6be8a66a5e96e8a8452823e73dcadf9c')

prepare() {
  cd "${srcdir}/hs-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/hs-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/hs-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "${srcdir}/hs-${pkgver}"
  install -Dm755 target/release/hs "${pkgdir}/usr/bin/hs"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
  install -Dm644 completions/hs.bash "${pkgdir}/usr/share/bash-completion/completions/hs"
  install -Dm644 completions/_hs "${pkgdir}/usr/share/zsh/site-functions/_hs"
  install -Dm644 completions/hs.fish "${pkgdir}/usr/share/fish/vendor_completions.d/hs.fish"
}
